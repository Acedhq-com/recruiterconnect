# Server-side configuration only. These are low-privilege publishable credentials,
# NOT a service-role key. The database's write-only RPC provides the permission boundary.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Enable only on the sandbox preview server, never on Vercel production.
ALLOW_PREVIEW_PROXY=0
APP_ORIGIN=https://findworkprivately.com
# Leave disabled until custom SMTP and both email-code templates are configured,
# database account tests pass, and a real recipient verifies the complete flow.
AUTH_EMAIL_READY=0
