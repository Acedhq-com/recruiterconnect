# INACTIVE TEMPLATE: implement adapters, configure the two repository variables,
# then rename this file to discovery-production.yml and require its status check.
# This contract job must be accompanied by real endpoint and SQL/RLS integration checks.
name: Discovery production contract

on:
  push:
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  production-contract:
    name: Production discovery contract (requires real adapters)
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    env:
      DISCOVERY_REQUIRE_PRODUCTION: "1"
      DISCOVERY_PY_TARGET: ${{ vars.DISCOVERY_PY_TARGET }}
      DISCOVERY_TS_TARGET: ${{ vars.DISCOVERY_TS_TARGET }}
      PYTHONHASHSEED: "0"
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          persist-credentials: false
      - uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7
        with:
          python-version: "3.14"
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7
        with:
          node-version: "24"
      - name: Install harness and application dependencies
        run: |
          python -m pip install --require-hashes -r requirements-ci.txt
          npm ci
          # Add your application's own dependency installation here.
      - name: Require real implementations and verify the contract
        run: python -m scripts.run_ci
      - name: Upload contract evidence, including on failure
        if: always()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7
        with:
          name: discovery-production-contract
          path: reports/
          if-no-files-found: error
          retention-days: 14
